# ============================================================
# .env.cloud.example  —  Cloud deployment template
# Sovereignty preserved: COMPUTE in cloud, DATA pinned to Iowa (US-Central).
# Copy to .env on your cloud host. DO NOT commit real keys.
# ============================================================

# --- Browserbase (cloud browser infra) ---
BROWSERBASE_API_KEY=__SET_ON_HOST__
BROWSERBASE_PROJECT_ID=__SET_ON_HOST__

# --- AI model (Stagehand extraction) ---
GEMINI_API_KEY=__SET_ON_HOST__
# OPENAI_API_KEY=__OPTIONAL__
# ANTHROPIC_API_KEY=__OPTIONAL__

# --- Database (Iowa-region managed Postgres or volume-mounted SQLite) ---
# Use a US-Central (Iowa) region instance to preserve ICDPA compliance.
DB_PATH=/data/intel.db
DB_ENCRYPTION_KEY=__GENERATE_32_BYTE_KEY_ON_HOST__
DB_REGION=us-central-iowa

# --- Data retention ---
DATA_RETENTION_DAYS=90

# --- Sync / scheduling ---
SYNC_INTERVAL_MINUTES=60

# --- Action engine (SAFE DEFAULTS for first cloud run) ---
# Auto-actions OFF until you validate the feed; threshold raised to 85.
ENABLE_AUTO_ACTIONS=false
ACTION_SCORE_THRESHOLD=85

# --- Privacy & compliance (DO NOT relax) ---
ENCRYPTION_ENABLED=true
LOCAL_STORAGE_ONLY=false   # cloud compute; data still pinned to Iowa region
IOWA_COMPLIANCE=true
DATA_REGION_LOCK=us-central-iowa

# --- Cloud runtime ---
NODE_ENV=production
PORT=8080
